<script>
// ===== CONFIG TONTINE CAVIAR - METS TES CLÉS SUPABASE ICI =====
const SUPABASE_URL = "https://TON-PROJET.supabase.co";
const SUPABASE_KEY = "eyJ...TON-ANON-KEY...";
const CINETPAY_API_KEY = "";
const CINETPAY_SITE_ID = "";
let supabaseClient = null;
try{ supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY); }catch(e){ console.log("Supabase en mode local"); }

let TONTINES = JSON.parse(localStorage.getItem('tontines_caviar')||'[]');
let PAIEMENTS = JSON.parse(localStorage.getItem('paiements_tontine_caviar')||'[]');
let TRANSACTIONS = JSON.parse(localStorage.getItem('transactions_verifiees_caviar')||'[]');
let utilisateurActuel = JSON.parse(localStorage.getItem('user_tontine_caviar')||'null');
let methodePay = 'Orange Money';
let captureBase64 = '';

if(TONTINES.length===0){
  TONTINES = [
    {code_groupe:'JOUR-800', nom_groupe:'Tontine Caviar Jour - 800F', montant:800, maman_tel:'55441010', maman_nom:'Nassara'},
    {code_groupe:'SOIR-2750', nom_groupe:'Tontine Caviar Soir - 2.750F', montant:2750, maman_tel:'55441010', maman_nom:'Nassara'},
    {code_groupe:'SEMAINE-5500', nom_groupe:'Tontine Caviar Semaine - 5.500F', montant:5500, maman_tel:'55441010', maman_nom:'Nassara'},
    {code_groupe:'MOIS-11000', nom_groupe:'Tontine Caviar Mois - 11.000F', montant:11000, maman_tel:'65471996', maman_nom:'Nassara'}
  ];
  localStorage.setItem('tontines_caviar', JSON.stringify(TONTINES));
}

function showPage(n){
  ['payer','maman','historique','creer','inscription','connexion'].forEach(p=>{
    let el=document.getElementById('page-'+p); if(el) el.classList.add('hidden');
    let btn=document.getElementById('btn-'+p); if(btn) btn.classList.remove('tab-active');
  });
  let target=document.getElementById('page-'+n); if(target) target.classList.remove('hidden');
  let b=document.getElementById('btn-'+n); if(b) b.classList.add('tab-active');
  document.getElementById('hero').style.display = (n==='payer') ? 'block':'none';
  if(n==='payer') remplirGroupes();
  if(n==='maman') afficherAttente();
  if(n==='historique') afficherHistoriqueMembre();
}
function remplirGroupes(){
  let sel=document.getElementById('payGroupe'); sel.innerHTML='';
  TONTINES.forEach(t=>{ let o=document.createElement('option'); o.value=t.code_groupe; o.textContent=t.nom_groupe+' — '+t.montant+'F — Maman: '+t.maman_nom; sel.appendChild(o); });
  updateMontant(); sel.onchange=updateMontant;
}
function updateMontant(){
  let code=document.getElementById('payGroupe').value;
  let t=TONTINES.find(x=>x.code_groupe===code); if(!t) return;
  document.getElementById('montantAffiche').textContent=t.montant+'F';
  document.getElementById('numMamanAffiche').textContent=t.maman_tel;
  document.getElementById('btnMontant').textContent=t.montant+'F';
}
function setMethode(m, btn){
  methodePay=m; document.querySelectorAll('.methode-btn').forEach(b=>b.classList.remove('bg-orange-50','border-orange-300'));
  btn.classList.add('bg-orange-50','border-orange-300');
}
document.getElementById('captureFile')?.addEventListener('change', e=>{
  let f=e.target.files[0]; if(!f) return;
  let r=new FileReader(); r.onload=()=>{ captureBase64=r.result; document.getElementById('capturePreview').innerHTML=`<img src="${captureBase64}" class="w-32 h-32 object-cover rounded-xl border">`; }; r.readAsDataURL(f);
});
async function verifierExistenceReelle(txId, montantAttendu){
  txId=txId.trim().toUpperCase().replace(/\s/g,'');
  if(TRANSACTIONS.find(t=>t.transaction_id===txId)) return {existe:false, raison:"❌ Cet ID a déjà été utilisé. Impossible de le réutiliser.", enAttente:false};
  if(txId.length<8) return {existe:false, raison:"❌ ID trop court. Vérifie ton SMS Orange / Moov.", enAttente:false};
  if(CINETPAY_API_KEY && CINETPAY_SITE_ID){
    try{
      let res=await fetch('https://api.cinetpay.com/v1/check-transaction',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({apikey:CINETPAY_API_KEY,site_id:CINETPAY_SITE_ID,transaction_id:txId})});
      let data=await res.json();
      if(!data.data) return {existe:false, raison:"❌ ID introuvable dans les dépôts reçus.", enAttente:false};
      let montantRecu=parseFloat(data.data.amount||0);
      if(montantRecu!==montantAttendu) return {existe:false, raison:`❌ Montant incorrect. Attendu ${montantAttendu}F, reçu ${montantRecu}F.`, enAttente:false};
      return {existe:true, raison:`✅ Vérifié par CinetPay : ${montantRecu}F reçus, ID ${txId} existe vraiment.`};
    }catch(e){ return {existe:false, raison:"⏳ Impossible de joindre CinetPay. Paiement mis en attente.", enAttente:true}; }
  }
  return {existe:false, raison:"⏳ Mode sans CinetPay : Paiement en attente. La Maman va vérifier dans son SMS Orange / Moov si l'argent est bien arrivé, puis valider.", enAttente:true};
}
async function payerTontine(){
  let code=document.getElementById('payGroupe').value;
  let t=TONTINES.find(x=>x.code_groupe===code); if(!t) return alert('Choisis un groupe');
  let txId=document.getElementById('txid').value.trim().toUpperCase();
  if(!txId) return alert('Tape ton ID de transaction. Tu le trouves dans le SMS après paiement.');
  let box=document.getElementById('ocrResult'); box.classList.remove('hidden'); box.className='mt-3 p-3 rounded-xl text-sm verif-wait'; box.innerHTML='🔍 Vérification en cours... La plateforme vérifie si l’ID <b>'+txId+'</b> existe vraiment...';
  let verif=await verifierExistenceReelle(txId, t.montant);
  if(!verif.existe && !verif.enAttente){ box.className='mt-3 p-3 rounded-xl text-sm verif-ko'; box.innerHTML=verif.raison; return; }
  if(verif.enAttente){
    let p={tel_membre:utilisateurActuel?.tel||'Anonyme', nom_membre:utilisateurActuel?utilisateurActuel.prenom+' '+utilisateurActuel.nom:'Membre', code_groupe:code, montant:t.montant, methode:methodePay, transaction_id:txId, capture:captureBase64, statut:'⏳ En attente - Maman doit vérifier SMS', date_paiement:new Date().toISOString().slice(0,10)};
    PAIEMENTS.push(p); localStorage.setItem('paiements_tontine_caviar', JSON.stringify(PAIEMENTS));
    if(supabaseClient) try{ await supabaseClient.from('paiements_tontine').insert([p]); }catch(e){}
    box.className='mt-3 p-3 rounded-xl text-sm verif-wait'; box.innerHTML=verif.raison+'<br><br>⏳ Ton paiement est en attente.';
    alert('⏳ Paiement en attente. La Maman va vérifier son SMS.'); afficherHistoriqueMembre(); return;
  }
  let tx={transaction_id:txId, tel_membre:utilisateurActuel?.tel||'Anonyme', code_groupe:code, montant:t.montant, created_at:new Date().toLocaleString('fr-FR')};
  TRANSACTIONS.push(tx); localStorage.setItem('transactions_verifiees_caviar', JSON.stringify(TRANSACTIONS));
  let p={tel_membre:utilisateurActuel?.tel||'Anonyme', nom_membre:utilisateurActuel?utilisateurActuel.prenom+' '+utilisateurActuel.nom:'Membre', code_groupe:code, montant:t.montant, methode:methodePay, transaction_id:txId, capture:captureBase64, statut:'✅ Validé - Vérifié', date_paiement:new Date().toISOString().slice(0,10)};
  PAIEMENTS.push(p); localStorage.setItem('paiements_tontine_caviar', JSON.stringify(PAIEMENTS));
  if(supabaseClient) try{ await supabaseClient.from('paiements_tontine').insert([p]); await supabaseClient.from('transactions_verifiees').insert([tx]); }catch(e){}
  box.className='mt-3 p-3 rounded-xl text-sm verif-ok'; box.innerHTML='✅ <b>PAIEMENT VÉRIFIÉ !</b><br>'+verif.raison+'<br>ID : '+txId;
  alert('✅ Paiement vérifié !'); afficherHistoriqueMembre();
}
function verifierIDPublic(){
  let tx=document.getElementById('checkTx').value.trim().toUpperCase();
  let box=document.getElementById('checkResult'); box.classList.remove('hidden');
  if(!tx) { box.className='mt-3 p-3 rounded-xl text-sm verif-ko'; box.innerHTML='Tape un ID pour vérifier.'; return; }
  let found=TRANSACTIONS.find(t=>t.transaction_id===tx);
  if(found){ box.className='mt-3 p-3 rounded-xl text-sm verif-ok'; box.innerHTML=`✅ ID <b>${tx}</b> déjà utilisé le ${found.created_at} pour ${found.code_groupe} - ${found.montant}F`; }
  else { let p=PAIEMENTS.find(x=>x.transaction_id===tx); if(p){ box.className='mt-3 p-3 rounded-xl text-sm verif-wait'; box.innerHTML=`⏳ ID <b>${tx}</b> trouvé, statut : ${p.statut}`; } else { box.className='mt-3 p-3 rounded-xl text-sm verif-ko'; box.innerHTML=`❌ ID <b>${tx}</b> introuvable.`; } }
}
function afficherAttente(){
  let div=document.getElementById('listeAttente');
  let att=PAIEMENTS.filter(p=>p.statut.includes('En attente'));
  if(att.length===0) div.innerHTML='<p class="text-sm text-gray-400">Aucun paiement en attente. Tout est à jour 👑</p>';
  else div.innerHTML=att.map((p,i)=>`<div class="border rounded-xl p-3 flex justify-between items-center"><div><b>${p.nom_membre}</b> — ${p.code_groupe} — ${p.montant}F<br><span class="text-xs">ID: ${p.transaction_id} • ${p.methode}</span></div><button onclick="validerPaiement(${PAIEMENTS.indexOf(p)})" class="bg-green-600 text-white px-3 py-1.5 rounded-full text-xs font-bold">Valider ✓</button></div>`).join('');
}
function validerPaiement(idx){
  PAIEMENTS[idx].statut='✅ Validé par la Maman';
  TRANSACTIONS.push({transaction_id:PAIEMENTS[idx].transaction_id, tel_membre:PAIEMENTS[idx].tel_membre, code_groupe:PAIEMENTS[idx].code_groupe, montant:PAIEMENTS[idx].montant, created_at:new Date().toLocaleString('fr-FR')});
  localStorage.setItem('paiements_tontine_caviar', JSON.stringify(PAIEMENTS));
  localStorage.setItem('transactions_verifiees_caviar', JSON.stringify(TRANSACTIONS));
  alert('✅ Validé !'); afficherAttente(); afficherHistoriqueMembre();
}
function afficherHistoriqueMembre(){
  let div=document.getElementById('historiqueMembre'); let div2=document.getElementById('historiqueList');
  let html = PAIEMENTS.slice(-5).reverse().map(p=>`<div class="border rounded-xl p-3 flex justify-between"><div><b>${p.code_groupe}</b> — ${p.nom_membre}<br><span class="text-xs">ID: ${p.transaction_id}</span></div><div class="text-right"><b>${p.montant}F</b><br><span class="text-xs">${p.statut}</span></div></div>`).join('') || '<p class="text-gray-400">Aucun paiement pour l’instant.</p>';
  if(div) div.innerHTML=html; if(div2) div2.innerHTML=html;
}
function creerGroupe(){
  let nom=document.getElementById('nomGroupe').value.trim();
  let montant=parseInt(document.getElementById('montantGroupe').value);
  let mTel=document.getElementById('mamanTel').value.trim();
  let mNom=document.getElementById('mamanNom').value.trim();
  if(!nom||!montant||!mTel) return alert('Remplis tout');
  let code=nom.toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,8)+'-'+montant;
  let g={code_groupe:code, nom_groupe:nom, montant, maman_tel:mTel, maman_nom:mNom||'Maman'};
  TONTINES.push(g); localStorage.setItem('tontines_caviar', JSON.stringify(TONTINES));
  if(supabaseClient) supabaseClient.from('tontines').insert([g]).then(()=>{});
  let box=document.getElementById('codeCree'); box.classList.remove('hidden'); box.innerHTML=`✅ Groupe créé !<br><b>Code : ${code}</b><br>Partage ce code à tes membres.`;
  remplirGroupes();
}
function inscrire(){
  let u={prenom:document.getElementById('insPrenom').value, nom:document.getElementById('insNom').value, tel:document.getElementById('insTel').value, pass:document.getElementById('insPass').value};
  if(!u.tel||!u.pass) return alert('Remplis téléphone + mot de passe');
  utilisateurActuel=u; localStorage.setItem('user_tontine_caviar', JSON.stringify(u));
  if(supabaseClient) supabaseClient.from('membres').insert([{prenom:u.prenom,nom:u.nom,tel:u.tel,mot_de_passe:u.pass}]).then(()=>{});
  alert('✅ Compte créé, bienvenue '+u.prenom+' !'); showPage('payer');
}
function connecter(){
  let tel=document.getElementById('logTel').value;
  utilisateurActuel={tel, prenom:'Membre', nom:''}; localStorage.setItem('user_tontine_caviar', JSON.stringify(utilisateurActuel));
  alert('✅ Connecté !'); showPage('payer');
}
remplirGroupes(); afficherHistoriqueMembre();
</script>
